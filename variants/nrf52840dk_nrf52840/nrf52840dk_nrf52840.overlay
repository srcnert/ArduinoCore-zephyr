/* Flash layout, shared with the MCUboot image as well. */
#include "nrf52840dk_nrf52840_partitions.dtsi"
/* Boot-mode retention area, shared with the MCUboot image as well. */
#include "nrf52840dk_nrf52840_bootmode.dtsi"

/{
	chosen {
		zephyr,console = &board_cdc_acm_logging;
		zephyr,log-uart = &log_uarts;
		zephyr,shell-uart = &board_cdc_acm_shell;
		zephyr,code-partition = &code_partition;
		/delete-property/ zephyr,uart-mcumgr;
	};

	log_uarts: log_uarts {
		compatible = "zephyr,log-uart";
		uarts = <&board_cdc_acm_logging>;
	};
};

/*
 * USB CDC-ACM ports, in enumeration order:
 *  1. logging: console (printk/stdout msg)+ log backend
 *  2. sketch:  the sketch's 'Serial' (SerialUSB)
 *  3. shell:   Zephyr shell (debug builds only, unused otherwise)
 */
&zephyr_udc0 {
	board_cdc_acm_logging: board_cdc_acm_logging {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};

	board_cdc_acm_sketch: board_cdc_acm_sketch {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};

	board_cdc_acm_shell: board_cdc_acm_shell {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};

	status = "okay";
	compatible = "nordic,nrf-usbd";
	num-bidir-endpoints = <1>;
	num-in-endpoints = <6>;
	num-out-endpoints = <3>;
	num-isoin-endpoints = <0>;
	num-isoout-endpoints = <0>;
};


/* RTC backend for the Arduino RTC library */
&rtc2 {
	status = "okay";
};

/delete-node/ &mx25r64;

&qspi {
	status = "disabled";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
};

&spi1 {
	status = "disabled";
};

/* Arduino API pin mappings */
/ {
	zephyr,user {
		digital-pin-gpios = <&arduino_header 6 0>,	/* D0 - P1.01 */
				    <&arduino_header 7 0>,	/* D1 - P1.02 */
				    <&arduino_header 8 0>,	/* D2 - P1.03 */
				    <&arduino_header 9 0>,	/* D3 - P1.04 */
				    <&arduino_header 10 0>,	/* D4 - P1.05 */
				    <&arduino_header 11 0>,	/* D5 - P1.06 */
				    <&arduino_header 12 0>,	/* D6 - P1.07 */
				    <&arduino_header 13 0>,	/* D7 - P1.08 */
				    <&arduino_header 14 0>,	/* D8 - P1.10 */
				    <&arduino_header 15 0>,	/* D9 - P1.11 */
				    <&arduino_header 16 0>,	/* D10 - P1.12 */
				    <&arduino_header 17 0>,	/* D11 - P1.13 */
				    <&arduino_header 18 0>,	/* D12 - P1.14 */
				    <&arduino_header 19 0>,	/* D13 - P1.15 */
				    <&arduino_header 20 0>,	/* D14 - P0.26 (SDA) */
				    <&arduino_header 21 0>,	/* D15 - P0.27 (SCL) */
				    <&arduino_header 0 0>,	/* D16 - A0 - P0.03 */
				    <&arduino_header 1 0>,	/* D17 - A1 - P0.04 */
				    <&arduino_header 2 0>,	/* D18 - A2 - P0.28 */
				    <&arduino_header 3 0>,	/* D19 - A3 - P0.29 */
				    <&arduino_header 4 0>,	/* D20 - A4 - P0.30 */
				    <&arduino_header 5 0>,	/* D21 - A5 - P0.31 */
				    <&gpio0 13 GPIO_ACTIVE_LOW>,	/* D22 - LED1 */
				    <&gpio0 14 GPIO_ACTIVE_LOW>,	/* D23 - LED2 */
				    <&gpio0 15 GPIO_ACTIVE_LOW>,	/* D24 - LED3 */
				    <&gpio0 16 GPIO_ACTIVE_LOW>,	/* D25 - LED4 */
				    <&gpio0 11 0>,	/* D26 - BUTTON1 */
				    <&gpio0 12 0>,	/* D27 - BUTTON2 */
				    <&gpio0 24 0>,	/* D28 - BUTTON3 */
				    <&gpio0 25 0>;	/* D29 - BUTTON4 */

		pwm-pin-gpios =     <&gpio0 13 GPIO_ACTIVE_LOW>,	/* LED1 */
				    <&arduino_header 9 0>,	/* D3 */
				    <&arduino_header 11 0>,	/* D5 */
				    <&arduino_header 12 0>,	/* D6 */
				    <&arduino_header 15 0>,	/* D9 */
				    <&arduino_header 16 0>,	/* D10 */
				    <&arduino_header 17 0>;	/* D11 */

		adc-pin-gpios =	    <&arduino_header 0 0>,	/* A0 */
				    <&arduino_header 1 0>,	/* A1 */
				    <&arduino_header 2 0>,	/* A2 */
				    <&arduino_header 3 0>,	/* A3 */
				    <&arduino_header 4 0>,	/* A4 */
				    <&arduino_header 5 0>;	/* A5 */

		pwms =	<&pwm0 0 255 PWM_POLARITY_INVERTED>,
			<&pwm0 1 255 PWM_POLARITY_NORMAL>,
			<&pwm0 2 255 PWM_POLARITY_NORMAL>,
			<&pwm0 3 255 PWM_POLARITY_NORMAL>,
			<&pwm1 0 255 PWM_POLARITY_NORMAL>,
			<&pwm1 1 255 PWM_POLARITY_NORMAL>,
			<&pwm1 2 255 PWM_POLARITY_NORMAL>;

		io-channels =	<&arduino_adc 0>,
				<&arduino_adc 1>,
				<&arduino_adc 2>,
				<&arduino_adc 3>,
				<&arduino_adc 4>,
				<&arduino_adc 5>;

		cdc-acm-serial = <&board_cdc_acm_sketch>; /* 'Serial' object is managed by SerialUSB */
		serials = <&uart1>, <&uart0>; /* 'Serial1' onwards */
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>; /* P0.03 - A0 */
		zephyr,resolution = <10>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN2>; /* P0.04 - A1 */
		zephyr,resolution = <10>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN4>; /* P0.28 - A2 */
		zephyr,resolution = <10>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN5>; /* P0.29 - A3 */
		zephyr,resolution = <10>;
	};

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN6>; /* P0.30 - A4 */
		zephyr,resolution = <10>;
	};

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>; /* P0.31 - A5 */
		zephyr,resolution = <10>;
	};
};

&pwm0 {
	status = "okay";
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-2 = <&pwm0_default>;
	pinctrl-names = "default", "sleep", "arduino";
};

&pwm1 {
	status = "okay";
	zephyr,deferred-init;
	pinctrl-0 = <&empty_default>;
	pinctrl-1 = <&pwm1_sleep>;
	pinctrl-2 = <&pwm1_default>;
	pinctrl-names = "default", "sleep", "arduino";
};

&pinctrl {
	empty_default: empty_default {
		group1 {
			psels = <>;
		};
	};

	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>;
			nordic,invert;
		};

		group2 {
			psels = <NRF_PSEL(PWM_OUT1, 1, 4)>,
				<NRF_PSEL(PWM_OUT2, 1, 6)>,
				<NRF_PSEL(PWM_OUT3, 1, 7)>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 13)>,
				<NRF_PSEL(PWM_OUT1, 1, 4)>,
				<NRF_PSEL(PWM_OUT2, 1, 6)>,
				<NRF_PSEL(PWM_OUT3, 1, 7)>;
			low-power-enable;
		};
	};

	pwm1_default: pwm1_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>,
				<NRF_PSEL(PWM_OUT1, 1, 12)>,
				<NRF_PSEL(PWM_OUT2, 1, 13)>;
		};
	};

	pwm1_sleep: pwm1_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 11)>,
				<NRF_PSEL(PWM_OUT1, 1, 12)>,
				<NRF_PSEL(PWM_OUT2, 1, 13)>;
			low-power-enable;
		};
	};
};
