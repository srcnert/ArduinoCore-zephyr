{
    "version": "2.0.0",
    "options": {
        "env": {
            "ZEPHYR_BASE": "${config:ZEPHYR_BASE}",
            "ZEPHYR_TOOLCHAIN_VARIANT": "${config:ZEPHYR_TOOLCHAIN_VARIANT}",
            "ZEPHYR_SDK_INSTALL_DIR": "${config:ZEPHYR_SDK_INSTALL_DIR}",
            // ------------------------------------ //
            // "BOARD_ARD": "nrf52840dk",
            // "BOARD_WEST": "nrf52840dk/nrf52840",
            // "VARIANT": "nrf52840dk_nrf52840",
            // "BOARD_OPTIONS": "",
            // "DEVICE": "nrf52840",
            // ------------------------------------ //
            "BOARD_ARD": "rak4631",
            "BOARD_WEST": "rak4631/nrf52840",
            "VARIANT": "rak4631_nrf52840",
            "BOARD_OPTIONS": ",baseboard=rak19007",
            "DEVICE": "nrf52840",
            // ------------------------------------ //
            // "SKETCH": "sketch/arduino_blinky",
            "SKETCH": "sketch/rzi/periodical_uplink",
            "SKETCH_DEBUG": "false",
            "SAMPLE": "samples/blinky_arduino",
            "SERIAL_PORT": "/dev/cu.usbmodem1101"
        },
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Loader",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Loader: Clean",
                "Loader: Build",
                "Loader: Flash (J-Link)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Loader: Build",
            "type": "shell",
            "command": "extra/build.sh",
            "args": [
                "${BOARD_ARD}",
                "-S", "rzi",
                // "-S", "rzi", "debug"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Loader: Flash (J-Link)",
            "type": "shell",
            "command": "west",
            "args": [
                "flash",
                "-d", "build/${VARIANT}",
                "-r", "jlink",
                "--no-rebuild",
                "--erase",
                "--reset"
            ],
            "problemMatcher": []
        },
        {
            // Board in MCUboot serial recovery (double-tap reset); MCUboot itself needs J-Link.
            "label": "Loader: Upload (mcumgr)",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "burn-bootloader",
                "-b", "rak:zephyr:${BOARD_ARD}",
                "-P", "mcumgr",
                "-p", "${SERIAL_PORT}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Loader: Clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "build",
                "firmwares",
                "variants/${VARIANT}/llext-edk",
                "variants/${VARIANT}/tls-syms.S",
                "variants/${VARIANT}/syms-dynamic.ld",
                "variants/${VARIANT}/syms-static.ld",
                "variants/${VARIANT}/includes.txt",
                "variants/${VARIANT}/machine_flags.txt",
                "variants/${VARIANT}/cflags.txt",
                "variants/${VARIANT}/cxxflags.txt",
                "boards.local.txt-e",
                "platform.local.txt-e",
                "loader/VERSION"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sketch",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Sketch: Clean",
                "Sketch: Build",
                "Sketch: Flash (pyOCD)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sketch: Build",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--warnings", "more",
                "--clean",
                "-b", "rak:zephyr:${BOARD_ARD}",
                "-e", "${SKETCH}",
                "--board-options", "debug=${SKETCH_DEBUG}${BOARD_OPTIONS}",
                // "-v"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Sketch: Flash (pyOCD)",
            "type": "shell",
            "command": "pyocd load -t ${DEVICE} -a 0x80000 ${SKETCH}/build/rak.zephyr.${BOARD_ARD}/$(basename ${SKETCH}).ino.elf-zsk.bin",
            "problemMatcher": []
        },
        {
            "label": "Sketch: Upload (mcumgr)",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "upload",
                "-b", "rak:zephyr:${BOARD_ARD}",
                "-p", "${SERIAL_PORT}",
                "--input-dir", "${SKETCH}/build/rak.zephyr.${BOARD_ARD}",
                "${SKETCH}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sketch: Clean",
            "type": "shell",
            "command": "rm -rf ${SKETCH}/build",
            "problemMatcher": []
        },
        {
            "label": "Sample",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Sample: Clean",
                "Sample: Build",
                "Sample: Flash"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sample: Build",
            "type": "shell",
            "command": "west build -p -d ${SAMPLE}/build -b ${BOARD_WEST} ${SAMPLE}",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Sample: Flash",
            "type": "shell",
            "command": "west flash --runner jlink -d ${SAMPLE}/build",
            "problemMatcher": []
        },
        {
            "label": "Sample: Clean",
            "type": "shell",
            "command": "rm -rf ${SAMPLE}/build",
            "problemMatcher": []
        },
        {
            "label": "All",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Loader: Clean",
                "Sketch: Clean",
                "Loader: Build",
                "Loader: Flash (J-Link)",
                "Sketch: Build",
                "Sketch: Flash (pyOCD)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",

            "dependsOrder": "sequence",
            "command": "find samples sketch -type d -name build -prune -exec rm -rf {} +",

            "dependsOn": [
                "Loader: Clean"
            ],
            "problemMatcher": []
        }
    ]
}
