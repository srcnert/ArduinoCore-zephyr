{
    "version": "2.0.0",
    "options": {
        "env": {
            "ZEPHYR_BASE": "${config:ZEPHYR_BASE}",
            "ZEPHYR_TOOLCHAIN_VARIANT": "${config:ZEPHYR_TOOLCHAIN_VARIANT}",
            "ZEPHYR_SDK_INSTALL_DIR": "${config:ZEPHYR_SDK_INSTALL_DIR}",
            "BOARD": "nrf52840dk",
            "VARIANT": "nrf52840dk_nrf52840",
            "DEVICE": "NRF52840_XXAA",
            "SKETCH": "sketch/blinky",
        },
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Loader: Build",
            "type": "shell",
            "command": "extra/build.sh",
            "args": [
                "${BOARD}",
                "--debug"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Loader: Flash (J-Link)",
            "type": "shell",
            "command": "${config:JLINK_PATH}/JLinkExe",
            "args": [
                "-device", "${DEVICE}",
                "-if", "SWD",
                "-speed", "4000",
                "-autoconnect", "1",
                "-CommanderScript", ".vscode/flash_loader.jlink"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sketch: Build",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "-b", "rak:zephyr:${BOARD}",
                "-e", "${SKETCH}",
                // "--v"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Sketch: Flash (J-Link)",
            "type": "shell",
            "command": "${config:JLINK_PATH}/JLinkExe",
            "args": [
                "-device", "${DEVICE}",
                "-if", "SWD",
                "-speed", "4000",
                "-autoconnect", "1",
                "-CommanderScript", ".vscode/flash_sketch.jlink"
            ],
            "problemMatcher": []
        },
        {
            "label": "Sketch: Clean",
            "type": "shell",
            "command": "rm -rf ${SKETCH}/build",
            "problemMatcher": []
        },
        {
            "label": "Loader: Clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "build",
                "firmwares",
                "variants/${VARIANT}/llext-edk",
                "variants/${VARIANT}/tls-syms.S",
                "variants/${VARIANT}/syms-dynamic.ld",
                "variants/${VARIANT}/syms-static.ld",
                "variants/${VARIANT}/includes.txt",
                "variants/${VARIANT}/machine_flags.txt",
                "variants/${VARIANT}/cflags.txt",
                "variants/${VARIANT}/cxxflags.txt",
                "boards.local.txt",
                "boards.local.txt-e"
            ],
            "problemMatcher": []
        },
    ]
}
